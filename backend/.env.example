# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dropsafe_v1?schema=public"

# Authentication & Security
JWT_SECRET="dropsafe_jwt_access_secret_super_secure_key_2026"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="dropsafe_jwt_refresh_secret_super_secure_key_2026"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
